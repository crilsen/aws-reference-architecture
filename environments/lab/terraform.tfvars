aws_region                                      = "us-east-1"
target_account_id                               = "replace-with-lab-account-id"
deployment_role_name                            = "OrganizationAccountAccessRole"
project_name                                    = "eks-lab"
kubernetes_version                              = "1.36"
vpc_cidr                                        = "10.42.0.0/16"
node_instance_types                             = ["t3.small"]
single_nat_gateway                              = true
nat_eip_allocation_id                           = "replace-with-nat-eip-allocation-id"
endpoint_public_access                          = false
public_access_cidrs                             = []
node_desired_size                               = 1
node_min_size                                   = 1
node_max_size                                   = 1
github_repository_url                           = "https://github.com/crilsen/aws-reference-architecture"
github_runner_registration_token_parameter_name = "/eks-lab/github-runner/registration-token"
